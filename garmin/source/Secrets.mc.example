// Template for Secrets.mc. Copy this file to `Secrets.mc` (which is gitignored)
// and fill in your values, then build.
//
// Why this exists: Garmin Connect Mobile cannot edit the settings of a
// *sideloaded* app, so the Server URL and watch token are baked into the build
// as a hard fallback (Config.mc uses these when the Garmin Connect setting is
// empty). Keep real values in Secrets.mc only - never commit them.
//
//   SERVER_URL - your backend base URL, e.g. https://your-app.run.app
//   API_TOKEN  - the watch token from the phone app (Watch access -> Generate token)
module Secrets {
    const SERVER_URL = "";
    const API_TOKEN = "";
}
